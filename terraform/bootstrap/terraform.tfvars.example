# Beispielwerte für die Trust-Policy der GitHub-OIDC-Rolle.
# Kopieren nach "terraform.tfvars" (wird von .gitignore ignoriert) und
# an das jeweilige Repo anpassen - oder bootstrap.sh die Werte automatisch
# per GitHub CLI ermitteln lassen.
#
# "environment" (dev/test/prod) wird von bootstrap.sh/destroy-bootstrap.sh
# automatisch als TF_VAR_environment gesetzt und muss hier normalerweise
# nicht eingetragen werden.

# --- GitHub.com Beispiel (Immutable Subject Claims) ---
# github_owner             = "<github-owner>"
# github_repo              = "<github-repo>"
# github_branch            = "main"
# github_owner_id          = <owner-id>
# github_repo_id           = <repo-id>
# github_oidc_provider_url = "https://token.actions.githubusercontent.com"

# --- GitHub Enterprise Server Beispiel ---
# github_owner             = "<github-owner>"
# github_repo              = "<github-repo>"
# github_branch            = "main"
# github_owner_id          = null
# github_repo_id           = null
# github_repo_id_ghes      = <repo-id-ghes>
# github_oidc_provider_url = "https://<ghes-host>/_services/token"
